{
  "name": "batikcode-pet",
  "displayName": "BatikCode Pet",
  "description": "A Nusantara companion that lives in the panel.",
  "publisher": "batikcode",
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "batikcode-pet",
          "title": "Pet",
          "icon": "resources/pet.svg"
        }
      ]
    },
    "views": {
      "batikcode-pet": [
        {
          "type": "webview",
          "id": "batikcode.pet.view",
          "name": "BatikCode Pet",
          "icon": "resources/pet.svg",
          "contextualTitle": "BatikCode Pet"
        }
      ]
    },
    "commands": [
      {
        "command": "batikcode.pet.show",
        "title": "Show Pet",
        "category": "BatikCode Pet"
      },
      {
        "command": "batikcode.pet.choose",
        "title": "Choose Pet",
        "category": "BatikCode Pet",
        "icon": "$(sparkle)"
      },
      {
        "command": "batikcode.pet.feed",
        "title": "Feed Pet",
        "category": "BatikCode Pet",
        "icon": "$(gift)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "batikcode.pet.choose",
          "when": "view == batikcode.pet.view",
          "group": "navigation@1"
        },
        {
          "command": "batikcode.pet.feed",
          "when": "view == batikcode.pet.view",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "BatikCode Pet",
      "properties": {
        "batikcode.pet.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the companion. When off, the pet stops animating and stops watching diagnostics."
        },
        "batikcode.pet.species": {
          "type": "string",
          "default": "komodo",
          "enum": [
            "komodo",
            "orangutan",
            "cendrawasih",
            "harimau"
          ],
          "enumDescriptions": [
            "Komodo dragon — Nusa Tenggara",
            "Orangutan — Kalimantan and Sumatra",
            "Cendrawasih (bird of paradise) — Papua",
            "Sumatran tiger — Sumatra"
          ],
          "description": "Which companion lives in the panel."
        },
        "batikcode.pet.motif": {
          "type": "string",
          "default": "kawung",
          "enum": [
            "kawung",
            "parang",
            "polos"
          ],
          "enumDescriptions": [
            "Kawung — intersecting circles",
            "Parang — diagonal waves",
            "Plain — no batik pattern"
          ],
          "description": "Batik motif worn by the pet and its ground."
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:batikcode-pet",
    "watch": "gulp watch-extension:batikcode-pet"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/99apps-id/batikcode.git"
  }
}
